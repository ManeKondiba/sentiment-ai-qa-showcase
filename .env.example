# =====================================================================
# Environment Variable Template for Sentiment AI QA Framework
# COPY THIS FILE TO '.env' AND REPLACE WITH YOUR ACTUAL API KEYS.
# DO NOT COMMIT YOUR '.env' FILE TO GIT / GITHUB.
# =====================================================================

# OpenAI / OpenAI-Compatible API Key (Groq, OpenRouter, vLLM, etc.)
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# Hugging Face API Token
HF_API_KEY=your_huggingface_api_token_here

# Custom HTTP REST Endpoint URL (Optional)
HTTP_PREDICTOR_ENDPOINT=http://localhost:8000/api/predict
